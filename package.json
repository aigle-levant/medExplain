{
  "name": "medexplain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite --host 0.0.0.0",
